// generated by hand: two-pass minimum / maximum of the colour channels and of the luminance
struct U { w: u32, h: u32, mode: u32, groups: u32 };
@group(0) @binding(0) var<uniform> u: U;
@group(0) @binding(1) var<storage, read> src: array<vec4<f32>>;
@group(0) @binding(2) var<storage, read_write> outp: array<vec4<f32>>;
var<workgroup> smin: array<vec4<f32>, 256>;
var<workgroup> smax: array<vec4<f32>, 256>;
fn lum(p: vec4<f32>) -> f32 { return 0.2126 * p.x + 0.7152 * p.y + 0.0722 * p.z; }
@compute @workgroup_size(256, 1, 1)
fn main(@builtin(local_invocation_index) li: u32, @builtin(workgroup_id) wg: vec3<u32>) {
    var mn = vec4<f32>(3.0e38, 3.0e38, 3.0e38, 1.0);
    var mx = vec4<f32>(-3.0e38, -3.0e38, -3.0e38, 0.0);
    if (u.mode == 0u) {
        let total = u.w * u.h;
        let stride = 256u * u.groups;
        for (var k = wg.x * 256u + li; k < total; k = k + stride) {
            let p = src[k];
            let l = lum(p);
            mn = vec4<f32>(min(mn.xyz, p.xyz), min(mn.w, l));
            mx = vec4<f32>(max(mx.xyz, p.xyz), max(mx.w, l));
        }
    } else {
        for (var k = li; k < u.groups; k = k + 256u) {
            let a = src[2u * k];
            let b = src[2u * k + 1u];
            mn = vec4<f32>(min(mn.xyz, a.xyz), min(mn.w, a.w));
            mx = vec4<f32>(max(mx.xyz, b.xyz), max(mx.w, b.w));
        }
    }
    smin[li] = mn;
    smax[li] = mx;
    workgroupBarrier();
    var s = 128u;
    loop {
        if (s == 0u) { break; }
        if (li < s) {
            let a = smin[li];
            let b = smin[li + s];
            smin[li] = vec4<f32>(min(a.xyz, b.xyz), min(a.w, b.w));
            let c = smax[li];
            let d = smax[li + s];
            smax[li] = vec4<f32>(max(c.xyz, d.xyz), max(c.w, d.w));
        }
        workgroupBarrier();
        s = s >> 1u;
    }
    if (li == 0u) {
        outp[2u * wg.x] = smin[0];
        outp[2u * wg.x + 1u] = smax[0];
    }
}
