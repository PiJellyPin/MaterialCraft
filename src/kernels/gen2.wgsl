                        for (var part = 0; part < parts; part = part + 1) {
                            var ox = 0.0;
                            var oy = 0.0;
                            var rr = rad;
                            if (dividing) {
                                var o = -0.55 * rad;
                                if (part == 0) { o = 0.55 * rad; }
                                ox = o * cs;
                                oy = o * sn;
                                rr = rad * 0.75;
                            }
