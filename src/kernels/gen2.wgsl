        }
        case 13u: {
            // herringbone: P0/1 cells, P2 gap, P3 bevel, P4 variation, P5 mode, P8..23 table (hor * 16 + bx * 4 + by)
            let x = uu * P(0u);
            let y = vv * P(1u);
            let ci = i32(floor(x));
            let cj = i32(floor(y));
            let ent = u32(P(8u + u32(remi(cj, 4) * 4 + remi(ci, 4))));
            let hor = ent >= 16u;
            let bx = i32((ent >> 2u) & 3u);
            let by = i32(ent & 3u);
            let ax = ci - remi(ci - bx, 4);
            let ay = cj - remi(cj - by, 4);
            var bw = 1.0;
            var bh = 2.0;
            if (hor) { bw = 2.0; bh = 1.0; }
            let d = max(min(min(x - f32(ax), f32(ax) + bw - x), min(y - f32(ay), f32(ay) + bh - y)), 0.0);
            let wx = remi(ax, i32(P(0u)));
            let wy = remi(ay, i32(P(1u)));
            let mo = i32(P(5u));
            if (mo == 1) { g = rnd(wx, wy, seed); }
            else if (mo == 2) { g = select(0.0, 1.0, hor); }
            else { g = smoothc(P(2u) * 0.5, P(2u) * 0.5 + P(3u), d) * (1.0 - P(4u) * rnd(wx, wy, seed)); }
            g = fin(g);
        }
        case 14u: {
            // arc pavement: P0/1 cells, P2 rings, P3 stones, P4 gap, P5 bevel, P6 variation, P7 mode
            let st = arc_stone(uu * P(0u), vv * P(1u) * 0.5, i32(P(0u)), i32(P(1u)), i32(P(2u)), P(3u));
            let key = rnd(i32(st[0]) * 31 + i32(st[2]), i32(st[1]) * 17 + i32(st[3]), seed);
            if (i32(P(7u)) == 1) { g = key; }
            else { g = smoothc(P(4u) * 0.5, P(4u) * 0.5 + P(5u), st[4]) * (1.0 - P(6u) * key); }
            g = fin(g);
        }
        case 15u: {
            // sdf_shape: P0 shape, P1 size, P2 aspect, P3 sides, P4 rotation, P5 round, P6/7 centre, P8 range
            let x = wrapd(uu - 0.5 - P(6u));
            let y = wrapd(vv - 0.5 - P(7u));
            let sn = sin(P(4u) * TAU);
            let cs = cos(P(4u) * TAU);
            let rx = cs * x + sn * y;
            let ry = -sn * x + cs * y;
            let sh = u32(P(0u));
            var d: f32;
            if (sh == 0u) { d = sqrt(x * x + y * y) - P(1u); }
            else if (sh == 1u) { d = sd_box(rx, ry, P(1u), P(1u) * max(P(2u), 0.01), min(P(5u), P(1u) * 0.99)); }
            else if (sh == 2u) { d = polygon_sdf(x, y, P(3u), P(1u), P(4u)); }
            else { d = abs(sqrt(x * x + y * y) - P(1u)) - max(P(1u) * 0.2, 0.005); }
            g = clamp(0.5 - d / (2.0 * max(P(8u), 1e-4)), 0.0, 1.0);
        }
        case 16u: {
            // sdf_form: P0 shape, P1 size, P2 repeat, P3 round, P4 scatter, P5 height scale
            let rep = P(2u);
            let cu = uu * rep;
            let cv = vv * rep;
            let ci = i32(floor(cu));
            let cj = i32(floor(cv));
            let x = cu - f32(ci) - 0.5;
            let y = cv - f32(cj) - 0.5;
            let r1 = rnd(remi(ci, i32(rep)), remi(cj, i32(rep)), seed);
            let sz = clamp(P(1u) * (1.0 - P(4u) * 0.6 * r1), 0.01, 0.5);
            let sh = u32(P(0u));
            var zc = sz * 0.3;
            if (sh == 0u || sh == 3u) { zc = sz; } else if (sh == 1u) { zc = sz * 0.8; }
            let top = 2.0;
            var t = 0.0;
            g = 0.0;
            for (var k = 0; k < 72; k = k + 1) {
                let z = top - t;
                let d = map3(sh, x, y, z - zc, sz, min(P(3u), sz * 0.9));
                if (d < 0.0007) { g = clamp(z * P(5u), 0.0, 1.0); break; }
                t = t + max(d, 0.003);
                if (t > top) { break; }
            }
        }
        default: {}
    }
    dst[i] = vec4<f32>(g, g, g, 1.0);
}
