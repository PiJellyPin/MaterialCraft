            let mo = i32(P(4u));
            if (mo == 1) { g = clamp(w3.y * 0.7, 0.0, 1.0); }
            else if (mo == 2) { g = clamp((w3.y - w3.x) * 1.4, 0.0, 1.0); }
            else if (mo == 3) { g = w3.z; }
            else { g = clamp(w3.x * 1.2, 0.0, 1.0); }
