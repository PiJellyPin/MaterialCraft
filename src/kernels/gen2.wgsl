        }
        case 2u: {
            // perlin 3D: P0/1/2 periods, P3 depth coordinate, P4 octaves, P5 gain
            var amp = 1.0;
            var sum = 0.0;
            var norm = 0.0;
            let oc = i32(P(4u));
            for (var o = 0; o < oc; o = o + 1) {
                let m = i32(1u << u32(o));
                let p = vec3<i32>(i32(P(0u)) * m, i32(P(1u)) * m, i32(P(2u)) * m);
                sum = sum + amp * perlin3(uu * f32(p.x), vv * f32(p.y), P(3u) * f32(m), p, seed + u32(o) * 131u);
                norm = norm + amp;
                amp = amp * P(5u);
