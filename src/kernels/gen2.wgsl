            let fa = a - floor(a);
            let fb = b - floor(b);
            let da = abs(fa - 0.5) * 2.0 / P(2u);
            let db = abs(fb - 0.5) * 2.0 / P(2u);
            let wave_a = 0.5 + 0.5 * cos(TAU * (wa + 0.5 * (floor(b) - 2.0 * floor(floor(b) / 2.0))));
            let wave_b = 0.5 + 0.5 * cos(TAU * (wb + 0.5 * (floor(a) - 2.0 * floor(floor(a) / 2.0)) + 0.5));
