            let r = voronoi_gen(uu, vv, i32(P(0u)), i32(P(1u)), seed, seed, P(2u), 0u, 2.0);
            let edge = (r.f2 - r.f1) * 1.4;
            let membrane = 1.0 - smoothc(P(3u) * 0.5, P(3u), edge);
