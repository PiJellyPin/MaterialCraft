        }
        case 8u: {
            // moisture noise: P0/1 periods, P2 coverage, P3 softness, P4 drips, P5 drip step, P6/7 streak periods
            let cover = P(2u);
            let soft = P(3u);
            let px = i32(P(0u));
            let py = i32(P(1u));
            let wf = f32(u.w);
            let hf = f32(u.h);
            let base = smoothc(1.0 - cover - soft, 1.0 - cover + soft, fbm_n(uu, vv, px, py, 4u, 0.5, seed, 0u));
            let st = smoothc(0.35, 0.75, fbm_n(uu, vv, i32(P(6u)), i32(P(7u)), 3u, 0.5, seed + 31u, 0u));
            var run = 0.0;
            for (var k = 1; k <= 14; k = k + 1) {
                let fall = 1.0 - f32(k) / 15.0;
                let yy = yi - i32(P(5u) * f32(k));
                let pv = smoothc(1.0 - cover - soft, 1.0 - cover + soft, fbm_n(uu, (f32(remi(yy, i32(u.h))) + 0.5) / hf, px, py, 4u, 0.5, seed, 0u));
