            g = fin(clamp(0.5 + 0.5 * sum / norm * 1.2, 0.0, 1.0));
        }
        case 3u: {
            // paving: P0/1 periods, P2 jitter, P3 gap, P4 bevel, P5 height variation, P6 dome, P7 output
            let r = voronoi_gen(uu, vv, i32(P(0u)), i32(P(1u)), seed, seed, P(2u), 0u, 2.0);
            let edge = (r.f2 - r.f1) * 0.5;
            let gap = P(3u);
            let bevel = P(4u);
            let oi = i32(P(7u));
            if (oi == 1) { g = r.id1; }
            else if (oi == 2) { g = 1.0 - smoothc(gap, gap + bevel * 0.25, edge); }
            else {
