            var b = vv * ny;
            var wa = vv * ny;
            var wb = uu * nx;
            if (P(4u) > 0.5) {
                a = uu * nx + vv * ny;
                b = uu * nx - vv * ny;
                wa = uu * nx;
                wb = vv * ny;
